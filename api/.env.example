# ===== Server =====
PORT=3000

# ===== MongoDB =====
# Máy cá nhân:  mongodb://127.0.0.1:27017/task_manager
# MongoDB Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/task_manager
MONGODB_URI=mongodb://127.0.0.1:27017/task_manager

# ===== JWT =====
JWT_SECRET=doi_chuoi_nay_thanh_mot_chuoi_bi_mat_dai_va_ngau_nhien
JWT_EXPIRES_IN=7d

# ===== SMTP (gửi email từ backend) =====
# Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" (App Password) 16 ký tự
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Task Manager <your_email@gmail.com>"
# Số lần tối đa được thử gửi lại một email thất bại
EMAIL_MAX_ATTEMPTS=3

# ===== Nhắc việc trước hạn =====
ENABLE_REMINDER=true
# Chạy kiểm tra mỗi 15 phút
REMINDER_CRON="*/15 * * * *"
# Nhắc trước hạn bao nhiêu giờ
REMINDER_HOURS=24
